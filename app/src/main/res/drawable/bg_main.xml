<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="135" android:startColor="#F7FCF9" android:centerColor="#EAF8F1" android:endColor="#D6F0E3"/>
        </shape>
    </item>
    <item android:width="340dp" android:height="340dp" android:gravity="top|start" android:top="-120dp" android:left="-120dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="170dp" android:startColor="#7034D399" android:endColor="#0034D399"/>
        </shape>
    </item>
    <item android:width="380dp" android:height="380dp" android:gravity="bottom|end" android:bottom="-140dp" android:right="-140dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="190dp" android:startColor="#6086EFAC" android:endColor="#0086EFAC"/>
        </shape>
    </item>
    <item android:width="260dp" android:height="260dp" android:gravity="center_vertical|end" android:right="-100dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="130dp" android:startColor="#506EE7B7" android:endColor="#006EE7B7"/>
        </shape>
    </item>
</layer-list>
