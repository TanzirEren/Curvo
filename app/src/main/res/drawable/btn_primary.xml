<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#44FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#0F9D75" android:endColor="#34D399"/>
            <corners android:radius="26dp"/>
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle"><solid android:color="#FFFFFF"/><corners android:radius="26dp"/></shape>
    </item>
</ripple>
