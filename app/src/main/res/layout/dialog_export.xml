<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/glass_sheet"
    android:orientation="vertical"
    android:paddingStart="22dp" android:paddingEnd="22dp"
    android:paddingTop="12dp" android:paddingBottom="26dp">

    <View android:id="@+id/exHandle" android:layout_width="40dp" android:layout_height="4dp"
        android:layout_gravity="center_horizontal" android:background="#330B3D2E"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/exPreview" android:layout_width="96dp" android:layout_height="96dp"
            android:scaleType="fitCenter"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Export" android:textColor="#0B3D2E" android:textSize="22sp" android:textStyle="bold"/>
            <TextView android:id="@+id/exInfo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textColor="#0F9D75" android:textSize="14sp" android:textStyle="bold"/>
            <TextView android:id="@+id/exBg" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:textColor="#5B7F72" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:text="FORMAT" android:textColor="#0F9D75"
        android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.12"/>
    <LinearLayout android:id="@+id/exFormatRow" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:orientation="horizontal"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:text="SIZE (LONG SIDE)" android:textColor="#0F9D75"
        android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.12"/>
    <LinearLayout android:id="@+id/exSizeRow" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:orientation="horizontal"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:text="FILE NAME" android:textColor="#0F9D75"
        android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.12"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="50dp"
        android:layout_marginTop="6dp" android:background="@drawable/glass_input"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="16dp" android:paddingEnd="16dp">
        <EditText android:id="@+id/exName" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:background="@null" android:inputType="text"
            android:maxLines="1" android:singleLine="true" android:textColor="#0B3D2E" android:textSize="15sp"/>
        <TextView android:id="@+id/exExt" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#5B7F72" android:textSize="15sp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:orientation="horizontal">
        <TextView android:id="@+id/exSave" android:layout_width="0dp" android:layout_height="52dp"
            android:layout_weight="1" android:background="@drawable/btn_primary" android:clickable="true"
            android:gravity="center" android:text="Save" android:textColor="#FFFFFF"
            android:textSize="16sp" android:textStyle="bold"/>
        <TextView android:id="@+id/exShare" android:layout_width="0dp" android:layout_height="52dp"
            android:layout_marginStart="10dp" android:layout_weight="1" android:background="@drawable/btn_secondary"
            android:clickable="true" android:gravity="center" android:text="Save &amp; Share"
            android:textColor="#0B3D2E" android:textSize="16sp" android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
